{
  "name": "browserip",
  "version": "1.3.0",
  "private": true,
  "description": "Browser extension that shows your public IP and warns when your VPN is off or leaking.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "node --test \"e2e/*.e2e.js\"",
    "check": "node scripts/check-manifest.js",
    "locales": "node scripts/build-locales.js",
    "package": "bash scripts/package.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright": "1.63.0"
  }
}
