{
  "manifest_version": 3,
  "name": "My IP Address Viewer",
  "version": "1.0.0",
  "description": "Shows your current public IP address.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-gray-16.png",
      "32": "icons/icon-gray-32.png",
      "48": "icons/icon-gray-48.png",
      "128": "icons/icon-gray-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Show My IP"
  },
  "icons": {
    "16": "icons/icon-gray-16.png",
    "32": "icons/icon-gray-32.png",
    "48": "icons/icon-gray-48.png",
    "128": "icons/icon-gray-128.png"
  },
  "permissions": [],
  "host_permissions": [
    "https://api.ipapi.is/*"
  ]
}
